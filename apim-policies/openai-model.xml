<policies>
  <inbound>
    <base />
    <choose>
      <when condition="@(context.Subscription.Id == &quot;research-team-sub&quot; || context.Subscription.Id == &quot;engineering-team-sub&quot;)">
        <choose>
          <when condition="@{
            var prefix = context.Subscription.Id == &quot;research-team-sub&quot; ? &quot;research&quot; : &quot;engineering&quot;;
            var userId = context.Request.Headers.GetValueOrDefault(&quot;x-demo-user-id&quot;, &quot;&quot;);
            return !System.Text.RegularExpressions.Regex.IsMatch(userId, &quot;^&quot; + prefix + &quot;-user-[12]$&quot;);
          }">
            <return-response>
              <set-status code="400" reason="Invalid synthetic user" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-body>{"error":"The synthetic user is not valid for this team."}</set-body>
            </return-response>
          </when>
        </choose>
        <set-variable name="attribution-team" value="@(context.Subscription.Id == &quot;research-team-sub&quot; ? &quot;Research&quot; : &quot;Engineering&quot;)" />
        <set-variable name="attribution-user" value="@(context.Request.Headers.GetValueOrDefault(&quot;x-demo-user-id&quot;, &quot;unknown&quot;))" />
        <set-variable name="attribution-mode" value="synthetic" />
      </when>
      <otherwise>
        <validate-azure-ad-token tenant-id="{{tenant-id}}" header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="The access token is invalid." output-token-variable-name="validated-jwt">
          <audiences>
            <audience>api://{{entra-client-id}}</audience>
            <audience>{{entra-client-id}}</audience>
          </audiences>
          <required-claims>
            <claim name="scp" match="any" separator=" ">
              <value>access_as_user</value>
            </claim>
          </required-claims>
        </validate-azure-ad-token>
        <set-variable name="attribution-team" value="Presenter" />
        <set-variable name="attribution-user" value="@(((Jwt)context.Variables[&quot;validated-jwt&quot;]).Claims.GetValueOrDefault(&quot;oid&quot;, &quot;unknown&quot;))" />
        <set-variable name="attribution-mode" value="entra" />
      </otherwise>
    </choose>
    <set-body>@{
      var body = context.Request.Body.As&lt;Newtonsoft.Json.Linq.JObject&gt;(preserveContent: true);
      body["model"] = "gpt-5.4";
      body["instructions"] = "If the user requests copyrighted content such as books, lyrics, recipes, news articles or other content that may violate copyrights or be considered as copyright infringement, politely refuse and explain that you cannot provide the content. Include a short description or summary of the work that the user is asking for. You must not violate any copyrights under any circumstances.";
      return body.ToString(Newtonsoft.Json.Formatting.None);
    }</set-body>
    <llm-token-limit
      counter-key="@(context.Subscription.Id)"
      tokens-per-minute="20000"
      token-quota="500000"
      token-quota-period="Daily"
      estimate-prompt-tokens="true"
      retry-after-header-name="Retry-After"
      remaining-quota-tokens-header-name="x-token-quota-remaining"
      remaining-tokens-header-name="x-tokens-remaining"
      tokens-consumed-header-name="x-tokens-consumed" />
    <llm-content-safety backend-id="foundry-content-safety" shield-prompt="true" enforce-on-completions="true">
      <categories output-type="EightSeverityLevels">
        <category name="Hate" threshold="4" />
        <category name="SelfHarm" threshold="4" />
        <category name="Sexual" threshold="4" />
        <category name="Violence" threshold="4" />
      </categories>
    </llm-content-safety>
    <llm-emit-token-metric namespace="ai-observability-gateway">
      <dimension name="API ID" />
      <dimension name="Operation ID" />
      <dimension name="Product ID" />
      <dimension name="Subscription ID" />
      <dimension name="Team" value="@((string)context.Variables[&quot;attribution-team&quot;])" />
      <dimension name="User" value="@((string)context.Variables[&quot;attribution-user&quot;])" />
      <dimension name="Model" value="gpt-5.4" />
      <dimension name="Project" value="platform-engineering" />
      <dimension name="Attribution Mode" value="@((string)context.Variables[&quot;attribution-mode&quot;])" />
    </llm-emit-token-metric>
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="api-key" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-query-parameter name="subscription-key" exists-action="delete" />
    <set-header name="x-demo-user-id" exists-action="delete" />
    <set-backend-service backend-id="foundry-openai-model" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <set-header name="x-ai-model" exists-action="override">
      <value>gpt-5.4</value>
    </set-header>
    <set-header name="x-attribution-team" exists-action="override">
      <value>@((string)context.Variables["attribution-team"])</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
