{
  "openapi": "3.0.1",
  "info": {
    "title": "Anthropic Messages API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/messages": {
      "post": {
        "operationId": "createClaudeMessage",
        "summary": "Create a Claude message",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "messages",
                  "max_tokens"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "type": "string"
                        },
                        "content": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2048
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Model response"
          }
        }
      }
    }
  }
}
