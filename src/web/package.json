{
  "name": "ai-observability-demo-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web application for the AI observability demo",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build": "node scripts/copy-govuk-assets.js",
    "test:auth-logging": "node scripts/test-auth-logging.js",
    "test:auth-validation": "node scripts/test-auth-validation.js",
    "test:easyauth-harness-guards": "node scripts/test-easyauth-harness-guards.js",
    "test:dependency-security": "node scripts/test-dependency-security.js",
    "test:weather": "node scripts/test-weather-api.js",
