    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "govuk-frontend": "^5.12.0",
    "helmet": "^8.1.0",
    "markdown-it": "^14.3.0",
    "morgan": "^1.10.1",
    "nunjucks": "^3.2.4",
    "sanitize-html": "^2.17.7"
