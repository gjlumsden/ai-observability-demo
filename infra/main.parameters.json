{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "appServiceLocation": {
      "value": "${AZURE_APP_SERVICE_LOCATION=${AZURE_LOCATION}}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "entraClientId": {
      "value": "${ENTRA_CLIENT_ID=}"
    },
    "budgetStartDate": {
      "value": "${BUDGET_START_DATE}"
    },
    "budgetEndDate": {
      "value": "${BUDGET_END_DATE}"
    }
  }
}
